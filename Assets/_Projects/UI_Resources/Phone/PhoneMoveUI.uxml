<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; justify-content: center; align-items: center;">
        <ui:Label name="MaxSpeedLabel" text="最大加速度 : 0.00" style="unity-text-align: middle-center; font-size: 50px;"/>
        <ui:Label name="SpeedLabel" text="加速度 : 0.00" style="unity-text-align: middle-center; font-size: 50px;"/>
        <ui:Label name="HeadingLabel" text="方角 : 0" style="unity-text-align: middle-center; font-size: 50px;"/>
        <ui:VisualElement style="width: 6%; height: 27%; border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px; position: absolute; right: 24%; top: 46%; flex-direction: column-reverse; background-color: rgb(141, 141, 141);">
            <ui:VisualElement name="AccelerationGauge" style="background-color: rgb(0, 200, 0); flex-grow: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
